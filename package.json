{
  "name": "molan-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test:regression": "tsx server/scripts/regression-audit.mts",
    "test:e2e": "tsx server/scripts/e2e-audit.mts",
    "test:e2e:browser": "tsx server/scripts/e2e-browser.mts",
    "test:audit": "npm run test:regression && npm run test:e2e && npm run test:e2e:browser && npm run test:e2e:mobile && npm run test:e2e:theme && npm run test:pg-lease",
    "test:pg-lease": "tsx server/scripts/pg-lease-audit.mts",
    "test:live-model": "tsx server/scripts/live-model-audit.mts",
    "migrate:sqlite-to-pg": "tsx server/scripts/migrate-sqlite-to-pg.mts",
    "quarantine:legacy-phys": "tsx server/scripts/quarantine-legacy-phys.mts",
    "test:e2e:mobile": "tsx server/scripts/e2e-mobile.mts",
    "test:e2e:theme": "tsx server/scripts/e2e-theme.mts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.1.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^1.19.0",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "11.10.0",
    "hono": "^4.9.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "description": "墨兰写作（molan os）— 以一本书为中心的长篇写作工作台"
}
